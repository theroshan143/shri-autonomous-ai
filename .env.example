# Groq API key (required — get your key at https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-key-here

# Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Breeth API key (required for semantic memory)
BREETH_API_KEY=your-breeth-key-here

# Publishing cycle interval in minutes (default: 15)
CYCLE_INTERVAL_MINUTES=15

# Total autonomous runtime in hours (default: 48)
RUNTIME_HOURS=48
